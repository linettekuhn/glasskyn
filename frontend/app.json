{
  "expo": {
    "name": "Glasskyn",
    "slug": "glasskyn",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-light.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#CDFFF8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#031D1D"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-brightness",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#031D1D"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "scheme": "cosmetic-expiry",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.linettekuhn.glasskyn",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Glasskyn uses your camera to scan product labels, so it can autofill ingredients and flag irritants, and to take face photos for your Skin Journal to track changes in your skin over time."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/foreground-icon.png",
        "backgroundImage": "./assets/background-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#CDFFF8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.linettekuhn.glasskyn",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "apiUrl": "",
      "eas": {
        "projectId": "7180bd60-abb7-4256-8fc1-a7196de916e2"
      }
    },
    "owner": "linettekuhn",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7180bd60-abb7-4256-8fc1-a7196de916e2"
    }
  }
}
